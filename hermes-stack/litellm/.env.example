# Copy to ~/.litellm/.env and fill in. NEVER commit the filled-in copy.
# scripts/bootstrap.sh will place it and chmod 600 it for you.

# Local proxy auth. Any string; only your machine talks to the proxy.
LITELLM_MASTER_KEY=sk-local-hermes-CHANGE-ME

# ── Local inference (RTX 2070, 8 GB) ─────────────────────────────────────────
# Set up with scripts/setup-local-model.sh, then scripts/local-tier.sh on.
LOCAL_API_BASE=http://127.0.0.1:11434/v1
LOCAL_API_KEY=not-needed

# ── Groq ─────────────────────────────────────────────────────────────────────
# 30 RPM / 6K TPM / 14.4K requests per day, counted per ORGANISATION -- extra
# API keys do not raise it. The 6K TPM is why groq-fast is fenced to short prompts.
GROQ_API_KEY=

# ── Mistral / Codestral ──────────────────────────────────────────────────────
# BEFORE THE FIRST REQUEST: console.mistral.ai -> Admin -> Privacy -> turn off
# data sharing for model training. The free Experiment tier trains on your
# prompts by default.
MISTRAL_API_KEY=
# Alternative endpoint for a personal Codestral key (IDE/coding-assistant tier,
# separate from organisation limits). To use it, change the codestral entry in
# config.yaml to `model: codestral/codestral-latest` and set this instead:
# CODESTRAL_API_KEY=

# ── SambaNova ────────────────────────────────────────────────────────────────
# 20 RPM / 200K tokens per day, per model. Free tier applies while no payment
# method is attached; adding one silently moves you to the paid Developer tier.
SAMBANOVA_API_KEY=

# ── OpenRouter (last resort) ─────────────────────────────────────────────────
# 20 RPM on :free variants. 50 requests/day, or 1000/day if the account has ever
# purchased $10 of credit. Set your privacy preference in the OpenRouter account
# settings first -- it controls whether prompts may reach providers that train
# on them. Refresh the model pick with scripts/refresh-openrouter-free.py.
OPENROUTER_API_KEY=

# ── Aion Labs (off-topic / inconsequential only) ─────────────────────────────
# 15 RPM / 20K tokens per DAY. Serves Hermes' side-task slots, no coding tier.
AION_API_KEY=

# ── Qwen / DashScope ─────────────────────────────────────────────────────────
# International account:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Beijing account:        https://dashscope.aliyuncs.com/compatible-mode/v1
# The two are separate accounts with separate keys. Using the wrong pair is the
# usual cause of a 401 that looks like a bad key.
DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# ── Cerebras ─────────────────────────────────────────────────────────────────
CEREBRAS_API_KEY=

# ── NVIDIA NIM ───────────────────────────────────────────────────────────────
NVIDIA_API_KEY=

# ── Cloudflare Workers AI ────────────────────────────────────────────────────
# Whole URL in one variable, account id already substituted. LiteLLM does not
# interpolate os.environ/ inside a longer string.
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
CLOUDFLARE_API_KEY=

# ── Gemini (long-context rescue, late fallback) ──────────────────────────────
# Free-tier prompts may be used to improve Google's products.
GEMINI_API_KEY=

# ── Optional / disabled by default ───────────────────────────────────────────
# POLLINATIONS_API_KEY=
